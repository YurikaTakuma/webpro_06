<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title><%= data.name %>の編集</title>
</head>
<body>
  <h2><%= data.name %>の編集</h2>

  <form action="/keiyo2/update/<%= id %>" method="POST">
    <table>
      <tr>
        <th>項目</th>
        <th>データ</th>
      </tr>

      <tr>
        <td>駅コード</td>
        <td>
          <input type="text" name="code" value="<%= data.code %>" required>
        </td>
      </tr>

      <tr>
        <td>駅名</td>
        <td>
          <input type="text" name="name" value="<%= data.name %>" required>
        </td>
      </tr>

      <tr>
        <td>乗り換え線</td>
        <td>
          <input type="text" name="change" value="<%= data.change %>">
        </td>
      </tr>

      <tr>
        <td>乗降客数</td>
        <td>
          <input type="text" name="passengers" value="<%= data.passengers %>" required>
        </td>
      </tr>

      <tr>
        <td>東京駅からの距離</td>
        <td>
          <input type="text" name="distance" value="<%= data.distance %>" required>
        </td>
      </tr>
    </table>

    <input type="submit" value="更新">
  </form>

  <a href="/keiyo2">駅一覧に戻る</a>
</body>
</html>